<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.aerf</groupId>
    <artifactId>aerf-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>aerf-extraction</artifactId>
  <packaging>jar</packaging>

  <name>AERF - Extraction Bridge</name>
  <description>
    The technology-agnostic extraction bridge AERF v0.4 section 9
    describes: fact types an extractor emits (NodeFact/EdgeFact over
    symbolic, not-yet-resolved SymbolRefs) and a GraphAssembler that
    resolves and merges them into a canonical Graph. Depends only on
    aerf-model; must never depend on any concrete extraction technology
    (e.g. OpenRewrite) — that boundary is what keeps the AERF graph from
    exposing OpenRewrite AST types, per section 9's central rule. A
    technology-specific adapter (e.g. aerf-openrewrite) implements
    SourceExtractor and depends on this module, not the other way round.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.aerf</groupId>
      <artifactId>aerf-model</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.aerf</groupId>
      <artifactId>aerf-model</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <!--
        This module must never depend on org.openrewrite - that is the
        whole point of it. See ExtractionAdapter Plan
        (docs/extraction-adapter-plan.md).
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>ban-openrewrite</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>org.openrewrite:*</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
